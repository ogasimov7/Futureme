# Copy to .env.local (git-ignored) and fill in. Restart `npx expo start` after changes.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Supabase (Project Settings → API). Both are public by design; RLS protects the data.
# Never put the secret / service_role key or the database password here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
